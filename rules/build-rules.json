{
  "version": 1,
  "applies_to": "Every build, in every repo, for everyone with this plugin installed. There is no per-repo switch: change a value here and every build follows it.",
  "questions": {
    "store": "build-questions",
    "digest": {
      "cron": "CRON_TZ=America/Chicago 52 16 * * *",
      "tz": "America/Chicago",
      "label": "Every day at 4:52 pm Central",
      "repos": "all-linked",
      "steps": "organize,sync,check,digest",
      "phone": "PushNotification",
      "where": "cloud"
    }
  },
  "lanes": {
    "done_means": "Every pull request the lane opened is merged or deliberately closed, its CI is green, and nothing it started is left on a branch without a pull request.",
    "max_fix_rounds_per_pr": 5,
    "infra_reruns_per_pr": 3
  },
  "stall": {
    "quiet_minutes": 30,
    "check_queued_minutes": 30,
    "check_running_minutes": 90,
    "broken_runner_failures": 3,
    "main_red_hours": 2
  },
  "refill": {
    "on_lane_done": "ask-steward",
    "steward_answers_within_minutes": 60
  },
  "steward": {
    "cron": "17 * * * *",
    "idle_hours": 6,
    "max_resumes_per_sweep": 10,
    "max_prs_classified": 150
  },
  "improve": {
    "sweeps": 24,
    "recurring_check_prs": 5,
    "recurring_sweeps": 3,
    "flaky_reruns": 2,
    "slower_merge_pct": 25
  },
  "capacity": {
    "cron": "*/10 * * * *",
    "max_cancels": 500,
    "sample_runs": 30,
    "backed_up_jobs": 20,
    "why": "Every 10 minutes where the scheduler allows it (cloud scheduled tasks run at most hourly): cancel queued runs nobody needs, restart runners that stayed offline or hung for two passes in a row (once per 30 minutes at most), and flag idle runners no queued job can reach. GitHub never reroutes a job to a runner with other labels.",
    "settle_minutes": 10,
    "restart_cooldown_minutes": 30,
    "keep_after_close": [],
    "max_restarts": 3,
    "max_close_lookups": 100,
    "min_rate_remaining": 1500,
    "report_cooldown_minutes": 240,
    "dedupe_workflows": [
      "CI",
      "test",
      "security",
      "backend-ci",
      "shell-ci",
      "app-ci",
      "repo-hygiene",
      "Qwen review",
      "HPortHealth/app:Auto-merge"
    ],
    "host": {
      "red_load_per_core": 1.5,
      "red_mem_pct": 95,
      "red_disk_pct": 90,
      "headroom_load_per_core": 0.8,
      "headroom_mem_pct": 75,
      "cooldown_minutes": 20,
      "min_slots": 2
    }
  }
}
